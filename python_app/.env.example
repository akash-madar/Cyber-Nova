# Gemini API Key (Google AI Studio — billing-enabled key recommended)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-4-hydrogen

# MySQL Database Connection (Windows Local MySQL 8.x)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
MYSQL_DATABASE=scholarai_db

# JWT Signing Secret (generate a strong random string before running)
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX_SECRET

# Backend API URL for Streamlit frontend
FASTAPI_BASE_URL=http://127.0.0.1:8000
