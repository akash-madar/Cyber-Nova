# GEMINI_API_KEY: Required for Gemini AI API calls (Agent 1 Search Grounding & Agent 2 Explanation/Planning).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional signing secret for session tokens (auto-generated fallback in memory if omitted).
SESSION_SECRET=""

# DB_PATH: Optional SQLite file path for local preview persistence (defaults to ./data/scholarai.db).
DB_PATH="./data/scholarai.db"
